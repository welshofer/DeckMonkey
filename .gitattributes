# Corpus decks and golden PDFs go through git LFS.
Corpus/**/*.key filter=lfs diff=lfs merge=lfs -text
Corpus/**/*.pdf filter=lfs diff=lfs merge=lfs -text
# Hostile files are kilobytes of synthetic bytes with no golden PDF; plain blobs so CI and a
# plain `git clone` see the real bytes without an LFS fetch.
Corpus/hostile/*.key -filter -diff -merge -text
*.swift text eol=lf
